{
  "name": "kidsviewer",
  "version": "1.0.0",
  "type": "module",
  "description": "A parental control app that limits children's screen time and promotes learning through educational challenges",
  "main": "dist-electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "preelectron-dev": "tsc -p electron/tsconfig.json",
    "electron-dev": "ELECTRON=true concurrently \"npm run dev\" \"wait-on http://localhost:5173 && ELECTRON_RENDERER_URL=http://localhost:5173 npx electron .\"",
    "electron-build": "npm run build && npm run build-electron",
    "build-electron": "tsc -p electron/tsconfig.json && electron-builder",
    "dist": "npm run build && npm run build-electron && electron-builder --publish=never"
  },
  "keywords": [
    "parental-control",
    "education",
    "screen-time",
    "learning",
    "children"
  ],
  "author": "James Wong",
  "license": "MIT",
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@capacitor/browser": "^7.0.2",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "i18next": "^23.7.6",
    "i18next-browser-languagedetector": "^7.2.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^13.5.0",
    "react-router-dom": "^6.20.1",
    "tailwind-merge": "^2.2.0",
    "zustand": "^4.4.7"
  },
  "build": {
    "appId": "com.kidsviewer.app",
    "productName": "KidsViewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist-electron",
        "to": "dist-electron",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
