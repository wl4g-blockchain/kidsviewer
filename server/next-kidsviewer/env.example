# Database
DATABASE_URL="postgresql://username:password@localhost:5432/kidsviewer"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="your-secret-key-here"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# RSA Keys for password encryption (generate with: npm run generate:rsa-keys)
RSA_PUBLIC_KEY="your-base64-encoded-public-key"
RSA_PRIVATE_KEY="your-base64-encoded-private-key"

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-turnstile-secret-key"
