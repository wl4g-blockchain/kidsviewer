{
    "version": 2,
    "buildCommand": "npm run build",
    "outputDirectory": ".next",
    "installCommand": "npm install",
    "framework": "nextjs",
    "functions": {
        "app/api/v1/auth/[...nextauth]/route.ts": {
            "maxDuration": 30
        },
        "app/api/v1/auth/session/route.ts": {
            "maxDuration": 30
        },
        "app/api/v1/auth/login/route.ts": {
            "maxDuration": 30
        }
    }
}
