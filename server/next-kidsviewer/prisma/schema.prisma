generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SysTenant {
  id         BigInt    @id @default(autoincrement())
  name       String    @db.VarChar(255)
  remark     String?   @db.VarChar(255)
  properties Json?
  createDate DateTime  @map("create_date") @db.Timestamptz(3)
  updateDate DateTime  @map("update_date") @db.Timestamptz(3)
  createBy   BigInt    @default(1) @map("create_by")
  updateBy   BigInt    @default(1) @map("update_by")
  delFlag    Int       @default(0) @map("del_flag")
  sys_user   SysUser[]

  @@map("sys_tenant")
}

model SysUser {
  id                 BigInt               @id(map: "sys_user_pkey1")
  name               String?              @db.VarChar(64)
  email              String?              @db.VarChar(64)
  password           String?              @db.VarChar(256)
  githubOpenid       String?              @map("github_openid") @db.VarChar(128)
  tenantId           BigInt               @map("tenant_id")
  userType           Int                  @default(1) @map("user_type")
  createDate         DateTime             @map("create_date") @db.Timestamptz(3)
  updateDate         DateTime             @map("update_date") @db.Timestamptz(3)
  createBy           BigInt               @default(1) @map("create_by")
  updateBy           BigInt               @default(1) @map("update_by")
  delFlag            Int                  @default(0) @map("del_flag")
  createdInvitations SysInvitationCode[]
  invitationUsages   SysInvitationUsage[]
  sys_tenant         SysTenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sys_user_tenant_id_fkey1")

  @@index([tenantId])
  @@map("sys_user")
}

model SysInvitationCode {
  id         BigInt               @id @default(autoincrement())
  code       String               @unique @db.VarChar(32)
  creatorId  BigInt               @map("creator_id")
  maxUses    Int                  @default(100) @map("max_uses")
  usedCount  Int                  @default(0) @map("used_count")
  expiresAt  DateTime?            @map("expires_at") @db.Timestamptz(3)
  isActive   Boolean              @default(true) @map("is_active")
  createDate DateTime             @map("create_date") @db.Timestamptz(3)
  updateDate DateTime             @map("update_date") @db.Timestamptz(3)
  createBy   BigInt               @default(1) @map("create_by")
  updateBy   BigInt               @default(1) @map("update_by")
  delFlag    Int                  @default(0) @map("del_flag")
  creator    SysUser              @relation(fields: [creatorId], references: [id], map: "sys_invitation_code_creator_fkey")
  usedBy     SysInvitationUsage[]

  @@index([creatorId])
  @@index([code])
  @@map("sys_invitation_code")
}

model SysInvitationUsage {
  id           BigInt            @id @default(autoincrement())
  invitationId BigInt            @map("invitation_id")
  userId       BigInt            @map("user_id")
  usedAt       DateTime          @map("used_at") @db.Timestamptz(3)
  createDate   DateTime          @map("create_date") @db.Timestamptz(3)
  updateDate   DateTime          @map("update_date") @db.Timestamptz(3)
  createBy     BigInt            @default(1) @map("create_by")
  updateBy     BigInt            @default(1) @map("update_by")
  delFlag      Int               @default(0) @map("del_flag")
  invitation   SysInvitationCode @relation(fields: [invitationId], references: [id], map: "sys_invitation_usage_invitation_fkey")
  user         SysUser           @relation(fields: [userId], references: [id], map: "sys_invitation_usage_user_fkey")

  @@index([invitationId])
  @@index([userId])
  @@map("sys_invitation_usage")
}

// NextAuth.js 需要的表
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  
  // KidsViewer 特定字段
  phone         String?
  userType      String    @default("PARENTAL")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  controlPassword String?
  
  // 关联的子用户
  persons       Person[]
  
  // 奖励配置
  rewardConfig  Json?
  
  // 存钱罐配置
  piggyBankConfig Json?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// KidsViewer 业务模型
model Person {
  id          Int      @id @default(autoincrement())
  name        String
  avatar      String?
  age         Int?
  grade       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // 关联的父用户
  parentId    String
  parent      User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  
  // 观看记录
  watchingSessions WatchingSession[]
  
  // 答题记录
  questionAnswers QuestionAnswer[]
}

model WatchingSession {
  id          Int      @id @default(autoincrement())
  platform    String
  content     String
  duration    Int      // 观看时长（秒）
  startTime   DateTime
  endTime     DateTime?
  createdAt   DateTime @default(now())
  
  // 关联的子用户
  personId    Int
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model QuestionAnswer {
  id          Int      @id @default(autoincrement())
  questionId  Int
  answer      String
  isCorrect   Boolean
  points      Int      @default(0)
  createdAt   DateTime @default(now())
  
  // 关联的子用户
  personId    Int
  person      Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
}