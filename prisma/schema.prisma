generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// System configuration table
model SysConfig {
  id         BigInt    @id @default(autoincrement())
  type       String    @db.VarChar(50)
  key        String    @db.VarChar(100)
  value      Json
  version    Int       @default(1)
  remark     String?   @db.VarChar(255)
  createDate DateTime  @map("create_date") @db.Timestamptz(3)
  createBy   BigInt    @default(1) @map("create_by")
  updateDate DateTime  @map("update_date") @db.Timestamptz(3)
  updateBy   BigInt    @default(1) @map("update_by")
  delFlag    Int       @default(0) @map("del_flag")

  @@index([type])
  @@index([key])
  @@index([type, key])
  @@index([version])
  @@map("sys_config")
}


model SysTenant {
  id         BigInt    @id @default(autoincrement())
  name       String    @db.VarChar(255)
  remark     String?   @db.VarChar(255)
  properties Json?
  createDate DateTime  @map("create_date") @db.Timestamptz(3)
  updateDate DateTime  @map("update_date") @db.Timestamptz(3)
  createBy   BigInt    @default(1) @map("create_by")
  updateBy   BigInt    @default(1) @map("update_by")
  delFlag    Int       @default(0) @map("del_flag")
  sys_user   SysUser[]
  families   Family[]

  @@map("sys_tenant")
}

model SysUser {
  id                 BigInt               @id(map: "sys_user_pkey1")
  name               String?              @db.VarChar(64)
  email              String?              @db.VarChar(64)
  password           String?              @db.VarChar(256)
  githubOpenid       String?              @map("github_openid") @db.VarChar(128)
  wallets            Json?                // Multi-chain wallet addresses: [{"chain":"ethereum","address":"0x...","chainId":1},{"chain":"starknet","address":"0x...","chainId":1}]
  tenantId           BigInt               @map("tenant_id")
  userType           Int                  @default(1) @map("user_type")
  createDate         DateTime             @map("create_date") @db.Timestamptz(3)
  updateDate         DateTime             @map("update_date") @db.Timestamptz(3)
  createBy           BigInt               @default(1) @map("create_by")
  updateBy           BigInt               @default(1) @map("update_by")
  delFlag            Int                  @default(0) @map("del_flag")
  createdInvitations SysInvitationCode[]
  invitationUsages   SysInvitationUsage[]
  sys_tenant         SysTenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "sys_user_tenant_id_fkey1")

  @@index([tenantId])
  @@map("sys_user")
}

model SysInvitationCode {
  id         BigInt               @id @default(autoincrement())
  code       String               @unique @db.VarChar(32)
  creatorId  BigInt               @map("creator_id")
  maxUses    Int                  @default(100) @map("max_uses")
  usedCount  Int                  @default(0) @map("used_count")
  expiresAt  DateTime?            @map("expires_at") @db.Timestamptz(3)
  isActive   Boolean              @default(true) @map("is_active")
  createDate DateTime             @map("create_date") @db.Timestamptz(3)
  updateDate DateTime             @map("update_date") @db.Timestamptz(3)
  createBy   BigInt               @default(1) @map("create_by")
  updateBy   BigInt               @default(1) @map("update_by")
  delFlag    Int                  @default(0) @map("del_flag")
  creator    SysUser              @relation(fields: [creatorId], references: [id], map: "sys_invitation_code_creator_fkey")
  usedBy     SysInvitationUsage[]

  @@index([creatorId])
  @@index([code])
  @@map("sys_invitation_code")
}

model SysInvitationUsage {
  id           BigInt            @id @default(autoincrement())
  invitationId BigInt            @map("invitation_id")
  userId       BigInt            @map("user_id")
  usedAt       DateTime          @map("used_at") @db.Timestamptz(3)
  createDate   DateTime          @map("create_date") @db.Timestamptz(3)
  updateDate   DateTime          @map("update_date") @db.Timestamptz(3)
  createBy     BigInt            @default(1) @map("create_by")
  updateBy     BigInt            @default(1) @map("update_by")
  delFlag      Int               @default(0) @map("del_flag")
  invitation   SysInvitationCode @relation(fields: [invitationId], references: [id], map: "sys_invitation_usage_invitation_fkey")
  user         SysUser           @relation(fields: [userId], references: [id], map: "sys_invitation_usage_user_fkey")

  @@index([invitationId])
  @@index([userId])
  @@map("sys_invitation_usage")
}

model Family {
  id         BigInt        @id @default(autoincrement())
  tenantId   BigInt        @map("tenant_id")
  name       String        @db.VarChar(255)
  idcard     String?       @db.VarChar(20)
  address    String?       @db.VarChar(255)
  createDate DateTime      @map("create_date") @db.Timestamptz(3)
  updateDate DateTime      @map("update_date") @db.Timestamptz(3)
  createBy   BigInt        @default(1) @map("create_by")
  updateBy   BigInt        @default(1) @map("update_by")
  delFlag    Int           @default(0) @map("del_flag")
  tenant     SysTenant     @relation(fields: [tenantId], references: [id], map: "sys_user_tenant_id_fkey")

  @@index([tenantId])
  @@map("t_family")
}

// Platform management table
model TPlatform {
  id          BigInt    @id @default(autoincrement())
  nameEN      String    @map("name_en") @db.VarChar(255)
  nameCN      String    @map("name_cn") @db.VarChar(255)
  url         String    @db.VarChar(500)
  description String?   @db.VarChar(1000)
  ageGroups   String[]  @map("age_groups") // Array of age group strings
  isActive    Boolean   @default(true) @map("is_active")
  createDate  DateTime  @map("create_date") @db.Timestamptz(3)
  updateDate  DateTime  @map("update_date") @db.Timestamptz(3)
  createBy    BigInt    @default(1) @map("create_by")
  updateBy    BigInt    @default(1) @map("update_by")
  delFlag     Int       @default(0) @map("del_flag")

  @@map("t_platform")
}

// Question template management table
model TQuestion {
  id             BigInt    @id @default(autoincrement())
  type           String    @db.VarChar(50) // multiple-choice, true-false, fill-blank, calculation
  subject        String    @db.VarChar(50) // math, chinese, english
  difficulty     String    @db.VarChar(20) // beginner, easy, medium, hard, expert
  content        String    @db.Text
  options        String[]  // Array of option strings for multiple choice
  correctAnswer  String    @map("correct_answer") @db.VarChar(500)
  explanationEN  String?   @map("explanation_en") @db.Text
  explanationCN  String?   @map("explanation_cn") @db.Text
  language       String    @default("en") @db.VarChar(10)
  ageGroups      String[]  @map("age_groups") // Array of age group strings
  tags           String[]  // Array of tag strings
  isActive       Boolean   @default(true) @map("is_active")
  createDate     DateTime  @map("create_date") @db.Timestamptz(3)
  updateDate     DateTime  @map("update_date") @db.Timestamptz(3)
  createBy       BigInt    @default(1) @map("create_by")
  updateBy       BigInt    @default(1) @map("update_by")
  delFlag        Int       @default(0) @map("del_flag")

  @@index([subject])
  @@index([difficulty])
  @@index([ageGroups])
  @@index([isActive])
  @@map("t_question")
}

// Person management table (for parental control)
model TPerson {
  id                    BigInt    @id @default(autoincrement())
  userId                BigInt    @map("user_id")
  parentalId            BigInt    @map("parental_id")
  name                  String    @db.VarChar(100)
  alias                 String    @db.VarChar(100)
  ageGroup              String    @map("age_group") @db.VarChar(20) // preschool, young, older, teen
  avatar                String?   @db.VarChar(500)
  difficulty            String?   @db.VarChar(20)
  maxDailyTime          Int?      @map("max_daily_time") // in minutes
  parentalPassword      String?   @map("parental_password") @db.VarChar(255)
  settings              Json?     // PersonSettings as JSON
  statistics            Json?     // PersonStatistics as JSON
  isActive              Boolean   @default(true) @map("is_active")
  createDate            DateTime  @map("create_date") @db.Timestamptz(3)
  updateDate            DateTime  @map("update_date") @db.Timestamptz(3)
  createBy              BigInt    @default(1) @map("create_by")
  updateBy              BigInt    @default(1) @map("update_by")
  delFlag               Int       @default(0) @map("del_flag")

  @@index([userId])
  @@index([parentalId])
  @@index([isActive])
  @@map("t_person")
}
